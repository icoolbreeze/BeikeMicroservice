# property_verification 环境变量示例
# 复制为 .env 后按需填写；禁止提交真实值。

APP_ENV=dev
LOG_LEVEL=INFO

# 服务监听
PV_HOST=0.0.0.0
PV_PORT=8000

# 本地文件存储目录（留空则使用服务 storage/）
STORAGE_DIR=

# 视觉模型（顺序主备：主模型失败重试后仍失败，由兜底模型接管；至少配置一个）
# 主模型：OpenRouter（免费档）
OPENROUTER_API_KEY=
PV_VL_MODEL=nvidia/nemotron-nano-12b-v2-vl:free
# 兜底模型：NVIDIA build.nvidia.com
NVIDIA_API_KEY=
PV_VL_MODEL_FALLBACK=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
# 第二兜底模型（可选）：留空则不启用
PV_VL_MODEL_FALLBACK2=stepfun-ai/step-3.7-flash
# 每个模型失败（连接异常或未识别出有效字段）后的重试次数
PV_VL_RETRIES=2
# 单次模型调用超时（秒）
PV_VL_TIMEOUT=30
# 模型健康探活间隔（分钟）；不可用模型在提取链中直接跳过
PV_MODEL_HEALTH_INTERVAL_MINUTES=60

# 验证渠道页面地址（合法授权来源）
PV_VERIFICATION_URL=https://blmp.cdzjryb.com/fplc_daas_portal/#/integratedQueryNew?prevPageTitle=%E4%BD%8F%E5%BB%BA%E8%93%89e%E5%8A%9E&code=50

# 限流（同一 IP）与视觉模型账户级预算（OpenRouter / NVIDIA 各自独立）
PV_RATE_PER_MIN=2
PV_RATE_PER_DAY=30
PV_MODEL_RATE_PER_MIN=15
PV_MODEL_RATE_PER_DAY=800

# 上传与并发
PV_MAX_UPLOAD_MB=10
PV_MAX_CONCURRENT=3
# 最多等待任务数；不包含正在运行的 3 个浏览器任务
PV_MAX_QUEUED=12

# 产物保留与短期链接
# 任务产物（截图等）保留天数，超期由后台清理任务删除
PV_ARTIFACT_RETENTION_DAYS=7
# 短期签名链接的最大有效期（秒）
PV_DOWNLOAD_TOKEN_TTL=600
# 签名密钥；留空则进程启动时随机生成（链接随服务重启失效）
PV_DOWNLOAD_TOKEN_SECRET=

# 复用仓库 scripts 目录（留空则按本文件位置推断）
PV_SCRIPTS_DIR=

# pv-mcp（本地 MCP 进程）：指向已部署服务的地址
# 本地联调用 http://127.0.0.1:8000；云端部署可改为公网地址
PV_BASE_URL=http://127.0.0.1:8000
# 提交核验的本地限流（与服务端 2 次/分钟对齐）
PV_MCP_RATE_PER_MIN=2
# 状态轮询/产物下载等只读操作的本地限流
PV_MCP_POLL_RATE_PER_MIN=60
# 产物下载目录（留空则用系统临时目录）
PV_MCP_DOWNLOAD_DIR=
