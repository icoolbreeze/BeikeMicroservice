# property_verification 环境变量示例
# 复制为 .env 后按需填写；禁止提交真实值。

APP_ENV=dev
LOG_LEVEL=INFO

# 数据库（占位，当前不创建任何数据表）
DATABASE_URL=

# Redis / 任务队列（占位）
REDIS_URL=

# 本地文件存储目录
STORAGE_DIR=./storage

# OCR Provider（占位：当前不接入任何真实 OCR 引擎）
OCR_PROVIDER=

# 验证渠道（占位：仅允许配置合法授权渠道；禁止写入真实网址与凭据）
VERIFICATION_PROVIDER=
VERIFICATION_CHANNEL_URL=
VERIFICATION_CHANNEL_TOKEN=
