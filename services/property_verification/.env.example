# property_verification 环境变量示例
# 复制为 .env 后按需填写；禁止提交真实值。

APP_ENV=dev
LOG_LEVEL=INFO

# 服务监听
PV_HOST=0.0.0.0
PV_PORT=8000

# 本地文件存储目录（留空则使用服务 storage/）
STORAGE_DIR=

# OpenRouter 视觉模型（必填，用于证件字段提取）
OPENROUTER_API_KEY=
PV_VL_MODEL=nvidia/nemotron-nano-12b-v2-vl:free

# 验证渠道页面地址（合法授权来源）
PV_VERIFICATION_URL=https://blmp.cdzjryb.com/fplc_daas_portal/#/integratedQueryNew?prevPageTitle=%E4%BD%8F%E5%BB%BA%E8%93%89e%E5%8A%9E&code=50

# 限流（同一 IP）
PV_RATE_PER_MIN=1
PV_RATE_PER_DAY=10

# 上传与并发
PV_MAX_UPLOAD_MB=10
PV_MAX_CONCURRENT=1

# 复用仓库 scripts 目录（留空则按本文件位置推断）
PV_SCRIPTS_DIR=
