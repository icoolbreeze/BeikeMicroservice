SM_STORAGE_DIR=
SM_MAX_UPLOAD_MB=500
SM_SESSION_HOURS=12
# 跨域管理端地址，逗号分隔；同源部署时留空。
SM_CORS_ORIGINS=

# 精选房源大屏数据源：crm_connector 服务地址与缓存秒数。
SM_CRM_CONNECTOR_BASE_URL=http://127.0.0.1:8020
SM_FEATURED_CACHE_SECONDS=120
# 百度地图服务端 AK，用于小区行政区与坐标落库。不要提交真实密钥。
SM_BAIDU_MAP_AK=

# 顶部资讯：成都房协通知公告优先，新华网房产频道作为降级来源；多个地址用逗号分隔。
SM_NEWS_FEED_URL=https://www.cdfangxie.com/Infor/type/typeid/22.html,http://www.news.cn/house/ds_ae1f7b9d03624853bc927f6c216be3b3.json

# 仅在用户表为空时创建首个系统管理员。首次启动后应移除这两个变量。
SM_BOOTSTRAP_ADMIN_USERNAME=
SM_BOOTSTRAP_ADMIN_PASSWORD=
SM_BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员

# 清水房本地日 loop（`scripts/start_store_media.ps1` 默认 1）。三项开关独立:
#   SM_ROUGHCAST_CRAWL_ENABLED        总开关(默认 0);=1 才起 roughcast-daily-loop 线程
#   SM_ROUGHCAST_SCORE_AFTER_CRAWL    A 后是否跑 Shadow Run(默认 1);0 则只采不评
#   SM_ROUGHCAST_QUEUE_B_DAILY_LIMIT  队列 B 每日小区配额,0 当天不跑队列 B
SM_ROUGHCAST_CRAWL_ENABLED=0
SM_ROUGHCAST_SCORE_AFTER_CRAWL=1
SM_ROUGHCAST_QUEUE_B_DAILY_LIMIT=60
