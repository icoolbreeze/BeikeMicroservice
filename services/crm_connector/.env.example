# Non-sensitive runtime configuration only. Never put CRM sessions, tokens, cookies,
# real upstream URLs, or employee credentials in this file.
CC_BOUND_EMPLOYEE_PRINCIPAL=
CC_MCP_TRANSPORT=stdio
# 默认 kecom-prod：服务启动即接线真实 ke.com SSO，未登录时自动弹出扫码窗口。
# 设回 unconfigured 可关闭上游接线（CI / 纯本地开发）。
CC_UPSTREAM_PROFILE=kecom-prod
CC_REQUEST_TIMEOUT_SECONDS=15
CC_CORS_ORIGINS=
# MCP 工具每调用方每分钟配额（滑动窗口）。
CC_MCP_RATE_LIMIT_PER_MIN=30

# Credential & authd tuning. All values are placeholders; never paste real
# upstream addresses or secrets here.
CC_LOGIN_BASE=http://127.0.0.1:4000
CC_SERVICE_URL=http://127.0.0.1:4000/login?gotoURL=%252F
CC_BUSINESS_ORIGIN=http://127.0.0.1:4000
# Optional map gateway origin. Keep this a non-production placeholder in examples.
CC_CRM_MAP_ORIGIN=http://127.0.0.1:4000
CC_DEFAULT_CITY_CODE=510100
CC_CREDENTIAL_STORE_PATH=
CC_AUTHD_LISTEN_ADDRESS=127.0.0.1:8021
# 服务启动时若未登录（auth_required），自动在后台发起扫码登录并弹出原生二维码窗口。
# 设为 0/false 可关闭，改为通过 POST /api/v1/auth/login 手动触发。
CC_QR_LOGIN_AUTO_START=1
CC_BOOTSTRAP_POLL_INTERVAL_SECONDS=3
CC_BOOTSTRAP_POLL_TIMEOUT_SECONDS=300
# QR 过期后自动生成新码。延迟会以指数退避递增，最多 30 秒。
CC_BOOTSTRAP_QRCODE_REFRESH_INITIAL_DELAY_SECONDS=1
# 会话保活：默认 0 = 惰性校验（不周期探测上游；业务调用成功即滚动续期本地
# 过期估算，估算过期时下次调用先走 TGC 无感刷新）。设为正秒数可让
# crm-authd serve 恢复周期 keepalive 线程（一般不建议）。
CC_KEEPALIVE_INTERVAL_SECONDS=0
# 出站请求头与真实工作台浏览器保持一致，降低上游风控误判。UA 默认自动检测：
# 从注册表读取本机已安装浏览器版本重建（Chrome 优先，Edge 回退，静态值兜底）。
# 仅当你用便携版/非系统浏览器访问 CRM 时才需要在此强制指定。
CC_HTTP_USER_AGENT=
CC_HTTP_ACCEPT_LANGUAGE=zh-CN,zh;q=0.9
CC_CREDENTIAL_STORE_IN_MEMORY=
# 精选大屏快照定时推送：连接器内置守护线程按固定间隔采集精选房源，
# 通过 scp/ssh 原子替换云端 /var/lib/store-media/featured_snapshot.json。
# 由 scripts/start_crm_connector.ps1 在启动时注入，不再使用 Windows 计划任务。
CC_FEATURED_PUSH_ENABLED=1
CC_FEATURED_PUSH_INTERVAL_SECONDS=3600
CC_FEATURED_PUSH_LOCAL_API_BASE_URL=http://127.0.0.1:8020
CC_FEATURED_PUSH_REMOTE_HOST=beike-server
CC_FEATURED_PUSH_REMOTE_PATH=/var/lib/store-media/featured_snapshot.json

# 租赁房源本地化（默认开启）。按行政区轮询全部房源列表，已本地化的不打详情。
# 永不请求具体楼层 / 详细地址 / 跟进记录。
# 仅工作时间作业：09:00–21:00 Asia/Shanghai，21:00–09:00 暂停；日封顶 0=不限制。
# 关闭：CC_RENTAL_ARCHIVE_ENABLED=0
CC_RENTAL_ARCHIVE_ENABLED=1
CC_RENTAL_ARCHIVE_DB_PATH=
CC_RENTAL_ARCHIVE_DAILY_REQUEST_CAP=0
CC_RENTAL_ARCHIVE_DETAIL_DAILY_CAP=0
CC_RENTAL_ARCHIVE_WINDOW_START=09:00
CC_RENTAL_ARCHIVE_WINDOW_END=21:00
CC_RENTAL_ARCHIVE_DETAIL_TTL_DAYS=14

# 买卖房源本地化（默认开启，仅成都五城区：锦江/青羊/金牛/武侯/成华）。
# 独立 runner / SQLite / 游标，与租赁归档共用 CRM 账号与 09:00–21:00 窗口。
# 永不请求具体楼层 / 详细地址 / 业主预期价；日封顶 0=不限制。
# 关闭：CC_SALE_ARCHIVE_ENABLED=0
CC_SALE_ARCHIVE_ENABLED=1
CC_SALE_ARCHIVE_DB_PATH=
CC_SALE_ARCHIVE_DAILY_REQUEST_CAP=0
CC_SALE_ARCHIVE_DETAIL_DAILY_CAP=0
CC_SALE_ARCHIVE_WINDOW_START=09:00
CC_SALE_ARCHIVE_WINDOW_END=21:00
CC_SALE_ARCHIVE_DETAIL_TTL_DAYS=14
