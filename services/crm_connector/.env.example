# Non-sensitive runtime configuration only. Never put CRM sessions, tokens, cookies,
# real upstream URLs, or employee credentials in this file.
CC_BOUND_EMPLOYEE_PRINCIPAL=
CC_MCP_TRANSPORT=stdio
CC_UPSTREAM_PROFILE=unconfigured
CC_REQUEST_TIMEOUT_SECONDS=15
CC_CORS_ORIGINS=

# Credential & authd tuning. All values are placeholders; never paste real
# upstream addresses or secrets here.
CC_LOGIN_BASE=http://127.0.0.1:4000
CC_SERVICE_URL=http://127.0.0.1:4000/login?gotoURL=%252F
CC_BUSINESS_ORIGIN=http://127.0.0.1:4000
CC_DEFAULT_CITY_CODE=510100
CC_CREDENTIAL_STORE_PATH=
CC_AUTHD_LISTEN_ADDRESS=127.0.0.1:8021
CC_BOOTSTRAP_POLL_INTERVAL_SECONDS=3
CC_BOOTSTRAP_POLL_TIMEOUT_SECONDS=300
CC_KEEPALIVE_INTERVAL_SECONDS=3600
CC_CREDENTIAL_STORE_IN_MEMORY=
